<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>KspContinuum.OwnedRuntimeScheduleExample</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(OWNED_RUNTIME_ASSEMBLY)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireOwnedRuntimeAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="'$(OWNED_RUNTIME_ASSEMBLY)' == '' Or !Exists('$(OWNED_RUNTIME_ASSEMBLY)')"
      Text="Set OWNED_RUNTIME_ASSEMBLY to the actual owned Unity player's Assembly-CSharp.dll containing IOwnedRuntimeSchedule. This is not the original KSP assembly or the net8 Core library." />
  </Target>
</Project>
