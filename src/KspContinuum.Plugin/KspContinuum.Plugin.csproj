<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>KspContinuum</AssemblyName>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(KSP_MANAGED)/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="../KspContinuum.Core/*.cs" Link="%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Harmony2 is a shared CKAN dependency. Compile against it; never bundle 0Harmony.dll. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <Reference Include="Assembly-CSharp"><HintPath>$(KSP_MANAGED)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSP_MANAGED)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSP_MANAGED)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(KSP_MANAGED)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(KSP_MANAGED)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(KSP_MANAGED)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(KSP_MANAGED)/UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule"><HintPath>$(KSP_MANAGED)/UnityEngine.UnityWebRequestTextureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(KSP_MANAGED)/UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(KSP_MANAGED)/Assembly-CSharp.dll')" Text="Set KSP_MANAGED to your own KSP 1.12.5 Managed directory. Build never installs the plugin." />
  </Target>
</Project>
